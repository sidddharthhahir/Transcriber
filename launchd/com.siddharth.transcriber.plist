<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.siddharth.transcriber</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/siddharth/Madhav/transcriber/venv/bin/python</string>
        <string>/Users/siddharth/Madhav/transcriber/app.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/siddharth/Madhav/transcriber</string>

    <!-- Start now, start on every login, and restart automatically if it
         ever exits (crash, killed, etc). This is what makes it "24/7" as
         long as the Mac itself is on and awake. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/siddharth/Madhav/transcriber/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/siddharth/Madhav/transcriber/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Don't hammer restart attempts if something is fundamentally broken -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
